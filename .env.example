# LedgerMind secrets.
#
# Copy this file to .env (which stays on your machine and is never committed) and fill in only
# what you need. Empty values count as unset. A real environment variable overrides .env.

# Binance API key. Read-only is enough for paper mode. For live mode: spot trading only,
# withdrawals disabled.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Notion internal integration token and the ID of the daily reports database.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Optional CoinGecko demo API key.
COINGECKO_API_KEY=
